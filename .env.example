# AList 网盘挂载服务（必填）
ALIST_URL=http://127.0.0.1:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=to_do

# TMDB 只读访问令牌 Bearer Token（必填）
TMDB_TOKEN=to_do

# MDBList 多平台评分 API Key（选填，跳过则仅展示 TMDB 评分）
MDBLIST_APIKEY=to_do

# DeepSeek / OpenAI 兼容大模型接口（选填，跳过则仅使用本地规则识别）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=to_do
LLM_MODEL=deepseek-chat
# 可选值：responses 或 chat_completions
LLM_API=chat_completions

# 本地播放器可执行文件路径
PLAYER_PATH=C:\Program Files\MPC-HC\mpc-hc64.exe

# 服务监听配置（可选）
APP_HOST=127.0.0.1
APP_PORT=5000
